rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'saurav586kumar@gmail.com' ||
        request.auth.token.email == 'skylaneexperiment@gmail.com' ||
        request.auth.token.email == 'sumitiitan58@gmail.com' ||
        request.auth.token.email == 'admin@prepskm.com' ||
        request.auth.token.email == 'unfiltereddsumit@prepskm.com'
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /materials/{materialId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /mentors/{mentorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mentor_videos/{videoId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /custom_sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /custom_chapters/{chapterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /backlogs/{backlogId} {
      allow read, write: if true;
    }

    match /mock_results/{resultId} {
      allow read, write: if true;
    }

    match /mentorship_tokens/{tokenId} {
      allow read: if true;
      allow write: if true;
    }

    match /mentorship_bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }

    // Health check collection for connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
